# --- Google sign-in (NextAuth) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- AI agents (research + clip writing + chat) ---
# Optional: without it, the studio falls back to Wikipedia research and template scripts.
ANTHROPIC_API_KEY=
